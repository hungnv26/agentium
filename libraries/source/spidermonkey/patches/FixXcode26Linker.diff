Linker detection on Xcode 26 (ld-1267): `clang -Wl,-v` with no input file
exits 1 (undefined _main) but still prints the ld64 banner on stderr, so the
macOS 15 fallback must not require a zero exit code.
diff --git a/build/moz.configure/toolchain.configure b/build/moz.configure/toolchain.configure
--- a/build/moz.configure/toolchain.configure
+++ b/build/moz.configure/toolchain.configure
@@ -1910,7 +1910,7 @@ def select_linker_tmpl(host_or_target):
                 if target.kernel == "Darwin":
                     fallback_cmd = cmd_base + linker_flag + ["-Wl,-v"]
                     retcode2, stdout2, stderr2 = get_cmd_output(*fallback_cmd, env=env)
-                    if retcode2 == 0 and "@(#)PROGRAM:ld" in stderr2:
+                    if "@(#)PROGRAM:ld" in stderr2:
                         kind = "ld64"
                     else:
                         return None
